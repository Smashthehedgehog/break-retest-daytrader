[Unit]
Description=Break-and-Retest Day Trading Algo (main_algo.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/break-retest-daytrader
EnvironmentFile=-/etc/break-retest-daytrader.env
ExecStartPre=/home/ubuntu/break-retest-daytrader/.venv/bin/python scripts/init_db.py
ExecStart=/home/ubuntu/break-retest-daytrader/.venv/bin/python main_algo.py
Restart=always
RestartSec=30
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
