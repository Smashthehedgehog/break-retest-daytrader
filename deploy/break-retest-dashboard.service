[Unit]
Description=Break-and-Retest Streamlit Dashboard (127.0.0.1:8501 only, SSH-tunnel access)
After=network.target break-retest-bot.service
Wants=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/break-retest-daytrader
EnvironmentFile=-/etc/break-retest-daytrader.env
ExecStart=/home/ec2-user/break-retest-daytrader/.venv/bin/streamlit run dashboard.py --server.address 127.0.0.1 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
