# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored -- never commit real credentials.

# --- Alpaca API credentials ---
# Get these from https://app.alpaca.markets (paper) or your live account dashboard.
ALPACA_API_KEY=ENTER_YOUR_API_KEY_HERE
ALPACA_SECRET_KEY=ENTER_YOUR_SECRET_KEY_HERE

# --- Trading mode safety switch ---
# TRADING_MODE must be exactly "paper" or "live". Defaults to "paper" if unset/invalid.
TRADING_MODE=paper

# Both of the following must ALSO be true for live orders to ever be submitted.
# This is a deliberate double-confirmation so a single typo can't risk real money.
I_UNDERSTAND_LIVE_RISK=false

# --- Strategy parameters ---
TICKER=SPY
BASE_RISK=50.00
REWARD_RATIO=2.0

# --- Compounding buffer parameters ---
PROFIT_BUFFER_TARGET=200.00
SCALED_RISK=100.00
